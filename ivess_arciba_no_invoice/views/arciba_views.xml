<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_arciba_generated_files_form" model="ir.ui.view">
        <field name="name">arciba.generated.files.form.no.invoice</field>
        <field name="model">arciba.generated.files</field>
        <field
            name="inherit_id"
            ref="l10n_ar_eynes.view_arciba_generated_files_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <group string="Warnings" invisible="not notes">
                    <field name="notes" nolabel="1" colspan="2" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
