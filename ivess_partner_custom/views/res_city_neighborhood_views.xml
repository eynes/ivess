<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_city_neighborhood_list" model="ir.ui.view">
        <field name="name">res.city.neighborhood.list</field>
        <field name="model">res.city.neighborhood</field>
        <field name="arch" type="xml">
            <list string="Barrios" editable="top">
                <field name="name"/>
                <field name="city_id" options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="view_res_city_neighborhood_search" model="ir.ui.view">
        <field name="name">res.city.neighborhood.search</field>
        <field name="model">res.city.neighborhood</field>
        <field name="arch" type="xml">
            <search string="Barrios">
                <field name="name"/>
                <field name="city_id"/>
                <group>
                    <filter name="group_city" string="Ciudad" context="{'group_by': 'city_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_res_city_neighborhood" model="ir.actions.act_window">
        <field name="name">Barrios</field>
        <field name="res_model">res.city.neighborhood</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_res_city_neighborhood"
              name="Barrios"
              action="action_res_city_neighborhood"
              parent="contacts.menu_localisation"
              sequence="3"/>

    <!-- Ciudades: columna con los barrios de cada ciudad -->
    <record id="view_city_tree_neighborhood" model="ir.ui.view">
        <field name="name">res.city.list.neighborhood</field>
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_address_extended.view_city_tree"/>
        <field name="arch" type="xml">
            <field name="state_id" position="after">
                <field name="neighborhood_ids" widget="many2many_tags" string="Barrios"/>
            </field>
        </field>
    </record>

    <!-- Repartos: barrios que cubre cada reparto -->
    <record id="view_delivery_route_number_form_neighborhood" model="ir.ui.view">
        <field name="name">delivery.route.number.form.neighborhood</field>
        <field name="model">delivery.route.number</field>
        <field name="inherit_id" ref="logistic_custom_ivess.view_delivery_route_number_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Barrios" name="neighborhoods">
                    <field name="neighborhood_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
