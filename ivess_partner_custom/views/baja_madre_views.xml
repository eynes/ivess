<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_ivess_baja_madre_form" model="ir.ui.view">
        <field name="name">ivess.baja.madre.form</field>
        <field name="model">ivess.baja.madre</field>
        <field name="arch" type="xml">
            <form string="Dar de baja una cuenta madre">
                <div class="alert alert-warning" role="alert">
                    Esta cuenta tiene hijas activas. Elegí cuál pasa a ser la nueva madre: las demás
                    hijas quedan colgadas de ella y después se archiva esta cuenta.
                </div>
                <div class="alert alert-danger" role="alert" invisible="not saldo">
                    Esta madre tiene saldo a cobrar a su nombre (incluye lo facturado a sus hijas).
                    Si se da de baja desde acá, ese saldo queda en la cuenta archivada. Para pasarlo
                    a otra cuenta, cancelá y usá "Traspasar saldo y dar de baja".
                </div>
                <group>
                    <field name="madre_id"/>
                    <field name="saldo" invisible="not saldo"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="hija_ids" widget="many2many_tags"/>
                    <field name="nueva_madre_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_confirmar" type="object" string="Reasignar y dar de baja" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
