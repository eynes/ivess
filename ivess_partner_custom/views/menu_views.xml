<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ocultar el menú "Pagos" (Proveedores > Pagos) -->
    <record id="account.menu_action_account_payments_payable" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Ajustes internos por usuario (minuta del 01/10/2026): notas de débito
         y de crédito de cliente hechas en diarios de Comprobante Interno, por
         quién las cargó y por mes. Es el control mensual de control de gestión. -->
    <record id="view_account_move_ajustes_internos_pivot" model="ir.ui.view">
        <field name="name">account.move.ajustes.internos.pivot</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <pivot string="Ajustes Internos por Usuario">
                <field name="create_uid" type="row"/>
                <field name="move_type" type="row"/>
                <field name="invoice_date" interval="month" type="col"/>
                <field name="amount_total_signed" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_ajustes_internos_por_usuario" model="ir.actions.act_window">
        <field name="name">Ajustes Internos por Usuario</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="domain">[('journal_id.fiscal_type', '=', 'internal_voucher'), ('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '=', 'posted')]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_account_move_ajustes_internos_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_invoice_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
    </record>

    <menuitem id="menu_ajustes_internos_por_usuario"
              name="Ajustes Internos por Usuario"
              parent="account.menu_finance_reports"
              action="action_ajustes_internos_por_usuario"
              groups="account.group_account_manager"
              sequence="99"/>

</odoo>
