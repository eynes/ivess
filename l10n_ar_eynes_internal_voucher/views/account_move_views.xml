<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_inherit_internal_voucher" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.internal.voucher</field>
        <field name="model">account.move</field>
        <field
      name="inherit_id"
      ref="l10n_ar_eynes.account_move_view_form_inherit_l10n_ar_eynes"
    />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fiscal_type']" position="attributes">
                <attribute
          name="invisible"
        >move_type not in ('out_invoice', 'out_refund') and (move_type not in ('in_invoice', 'in_refund') or fiscal_type != 'internal_voucher')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
