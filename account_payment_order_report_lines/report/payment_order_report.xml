<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="payment_order_report_lines" inherit_id="l10n_ar_eynes.payment_order">

        <!-- Nueva sección: Otros Conceptos -->
        <xpath expr="//div[@id='payments']" position="after">
            <div id="other_concepts">
                <t t-if="o.concept_line_ids">
                    <h3>Otros Conceptos</h3>
                    <table class="table-bordered" width="100%">
                        <thead>
                            <tr
                style="background: black; color: white; text-align: left;"
              >
                                <th>
                                    <strong>Descripción</strong>
                                </th>
                                <th>
                                    <strong>Cuenta</strong>
                                </th>
                                <th>
                                    <strong>Diario</strong>
                                </th>
                                <th>
                                    <strong>Importe</strong>
                                </th>
                                <th>
                                    <strong>Cuenta Analítica</strong>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.concept_line_ids" t-as="line">
                                <td>
                                    <span t-field="line.name" />
                                </td>
                                <td>
                                    <span t-field="line.account_id.display_name" />
                                </td>
                                <td>
                                    <span t-field="line.journal_id.name" />
                                </td>
                                <td style="text-align: right;">
                                    <span
                    t-field="line.amount"
                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                  />
                                </td>
                                <td>
                                    <span t-field="line.account_analytic_id.name" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="7" style="text-align: right;">
                                    <strong>Total Otros Conceptos:
                                        <span
                      t-esc="sum(line.amount for line in o.concept_line_ids)"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                    />
                                    </strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </div>
        </xpath>

    </template>

</odoo>
