    <record id="account_payment_order_view_form_customer_label_fix_income_line" model="ir.ui.view">
        <field name="name">account.payment.order.view.form.customer.label.fix.income.line</field>
        <field name="inherit_id" ref="l10n_ar_eynes.account_customer_payment_order_view_form" />
