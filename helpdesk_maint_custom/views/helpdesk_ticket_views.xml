<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Additional Information tab (must come first so the DB view is updated before other views validate) -->
    <record id="helpdesk_ticket_view_form_inherit_maint" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.maint</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <field name="team_type" invisible="1"/>
                <page string="Additional Information" name="maint_additional_info"
                    invisible="team_type not in ('maintenance', 'workshop', 'refill')">
                    <group col="2" invisible="team_type != 'maintenance'">
                        <group string="Classification">
                            <field name="ticket_source"/>
                            <field name="topic"/>
                            <field name="department_id"/>
                            <field name="line"/>
                            <field name="maintenance_type"/>
                        </group>
                        <group string="Dates and Signature">
                            <field name="due_date"/>
                            <field name="require_signature"/>
                            <field
                                name="signature"
                                widget="signature"
                                invisible="not require_signature"
                            />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="warehouse_id"/>
                        </group>
                    </group>
                    <group string="Internal Note" invisible="team_type != 'maintenance'">
                        <field name="internal_note" nolabel="1"/>
                    </group>
                    <group col="2" invisible="team_type != 'workshop'">
                        <group string="Datos del Vehículo">
                            <field name="intake_user"/>
                            <field name="workshop_request_type"/>
                            <field name="dispatch_id"/>
                            <field name="dispatch"/>
                            <field name="driver_name"/>
                            <field name="vehicle_model"/>
                            <field name="equipment_id"/>
                        </group>
                        <group string="Ubicación y Auxilio">
                            <field name="vehicle_location"/>
                            <field name="breakdown_reason"/>
                            <field name="maps_location" widget="url"/>
                            <field name="intake_external_id"/>
                        </group>
                    </group>
                    <field name="item_ids" string="Ítems" invisible="team_type != 'workshop'"
                        nolabel="1">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="value"/>
                        </list>
                    </field>
                    <group col="2" invisible="workshop_request_type != 'accident'">
                        <group string="Conductor">
                            <field name="accident_business_unit"/>
                            <field name="driver_file_number"/>
                            <field name="driver_identification"/>
                            <field name="driver_address"/>
                        </group>
                        <group string="Siniestro">
                            <field name="accident_date"/>
                            <field name="accident_time" widget="float_time"/>
                            <field name="accident_address"/>
                            <field name="accident_city"/>
                        </group>
                    </group>
                    <group col="2" invisible="workshop_request_type != 'accident'">
                        <group string="Tercero">
                            <field name="third_party_name"/>
                            <field name="third_party_identification"/>
                            <field name="third_party_phone"/>
                            <field name="third_party_vehicle"/>
                            <field name="third_party_plate"/>
                            <field name="third_party_insurer"/>
                        </group>
                        <group string="Textos">
                            <field name="accident_vehicle_damage"/>
                            <field name="accident_facts"/>
                            <field name="third_party_vehicle_damage"/>
                            <field name="accident_notes"/>
                        </group>
                    </group>
                    <group string="Payload de ingreso" invisible="team_type != 'workshop'">
                        <field name="intake_payload" nolabel="1" readonly="1"/>
                    </group>
                    <group col="2" invisible="team_type != 'refill'">
                        <group string="Datos de Recarga">
                            <field name="refill_type"/>
                            <field name="dispatch_id"/>
                            <field name="dispatch"/>
                            <field name="refill_to_dispatch_id" invisible="refill_type != 'street'"/>
                            <field name="refill_to_dispatch" invisible="refill_type != 'street'"/>
                            <field name="vehicle_location" invisible="refill_type != 'factory'"/>
                            <field name="intake_external_id"/>
                        </group>
                    </group>
                    <group string="Payload de ingreso" invisible="team_type != 'refill'">
                        <field name="intake_payload" nolabel="1" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Search view: filtros y agrupamiento por tipo de solicitud del chatbot -->
    <record id="helpdesk_tickets_view_search_inherit_maint" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search.inherit.maint</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_search_base"/>
        <field name="arch" type="xml">
            <field name="team_id" position="after">
                <field name="dispatch" string="Reparto"/>
                <field name="equipment_id"/>
            </field>
            <filter name="archive" position="before">
                <separator/>
                <filter string="Checklist jMobile" name="filter_checklist"
                    domain="[('workshop_request_type', '=', 'checklist')]"/>
                <filter string="Novedades" name="filter_news"
                    domain="[('workshop_request_type', '=', 'news')]"/>
                <filter string="Auxilios" name="filter_breakdown"
                    domain="[('workshop_request_type', '=', 'breakdown')]"/>
                <filter string="Siniestros" name="filter_accident"
                    domain="[('workshop_request_type', '=', 'accident')]"/>
                <filter string="Sin equipo" name="filter_workshop_no_equipment"
                    domain="[('team_type', '=', 'workshop'), ('equipment_id', '=', False)]"/>
                <separator/>
                <filter string="Recarga fábrica" name="filter_refill_factory"
                    domain="[('refill_type', '=', 'factory')]"/>
                <filter string="Recarga en calle" name="filter_refill_street"
                    domain="[('refill_type', '=', 'street')]"/>
                <separator/>
            </filter>
            <filter name="assignee" position="after">
                <filter string="Tipo de solicitud" name="group_workshop_request_type"
                    context="{'group_by': 'workshop_request_type'}"/>
            </filter>
        </field>
    </record>

    <!-- Stat button: "Maintenance Orders" -->
    <record id="helpdesk_ticket_view_form_inherit_maint_stat_btn" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.maint.stat.btn</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <button name="action_open_helpdesk_ticket" position="before">
                <button class="oe_stat_button" name="action_view_maintenance_orders"
                    icon="fa-wrench" type="object"
                    invisible="maintenance_orders_count == 0">
                    <field name="maintenance_orders_count" string="Órdenes de Mantenimiento" widget="statinfo"/>
                </button>
            </button>
        </field>
    </record>

    <!-- Action button: "Crear orden de mantenimiento" -->
    <record id="helpdesk_ticket_view_form_inherit_maint_create_btn" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.maint.create.btn</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="model">helpdesk.ticket</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <field name="stage_id" position="before">
                <field name="use_maintenance_orders" invisible="1"/>
                <button name="action_create_maintenance_order" type="object"
                    string="Crear orden de mantenimiento"
                    invisible="not use_maintenance_orders"
                    data-hotkey="m"/>
            </field>
        </field>
    </record>
</odoo>
