<odoo>
    <record id="view_ivess_accounting_summary_job_list" model="ir.ui.view">
        <field name="name">ivess.accounting.summary.job.list</field>
        <field name="model">ivess.accounting.summary.job</field>
        <field name="arch" type="xml">
            <list string="Cierres Mensuales en Segundo Plano" decoration-danger="state == 'error'" decoration-success="state == 'done'" decoration-info="state not in ('done', 'error')">
                <field name="display_name" string="Cierre" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="user_id" widget="many2one_avatar_user" />
                <field name="state" widget="badge" />
                <field name="progress" widget="progressbar" />
                <field name="processed_lines" />
                <field name="total_lines" />
                <field name="started_at" />
                <field name="finished_at" />
                <field name="summary_move_id" />
            </list>
        </field>
    </record>

    <record id="view_ivess_accounting_summary_job_form" model="ir.ui.view">
        <field name="name">ivess.accounting.summary.job.form</field>
        <field name="model">ivess.accounting.summary.job</field>
        <field name="arch" type="xml">
            <form string="Cierre Mensual en Segundo Plano" create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Reintentar" class="btn-primary" invisible="state != 'error'" />
                    <button name="action_view_summary_move" type="object" string="Ver Asiento Resumen" class="btn-primary" invisible="not summary_move_id" />
                    <button name="action_view_netting_moves" type="object" string="Ver Asientos de Neteo" invisible="not netting_move_ids" />
                    <field name="state" widget="statusbar" statusbar_visible="queued,closing,building,posting,marking,done" />
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state in ('done', 'error')">
                        El cierre se está procesando en segundo plano por tandas. Podés cerrar esta
                        pantalla: se avisa cuando termina. Si falla, queda el motivo y se puede reintentar.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <strong>El cierre se detuvo.</strong> Corregí el problema y tocá Reintentar:
                        lo ya neteado no se repite.
                        <field name="error_message" nolabel="1" class="d-block mt-2" />
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="operational_journal_ids" widget="many2many_tags" />
                            <field name="legal_journal_id" />
                            <field name="summary_move_date" />
                            <field name="summary_move_ref" />
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user" />
                            <field name="progress" widget="progressbar" />
                            <field name="processed_lines" />
                            <field name="total_lines" />
                            <field name="chunks_done" />
                            <field name="started_at" />
                            <field name="finished_at" />
                            <field name="summary_move_id" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_ivess_accounting_summary_job_search" model="ir.ui.view">
        <field name="name">ivess.accounting.summary.job.search</field>
        <field name="model">ivess.accounting.summary.job</field>
        <field name="arch" type="xml">
            <search string="Cierres en Segundo Plano">
                <field name="user_id" />
                <filter name="in_progress" string="En proceso" domain="[('state', 'not in', ('done', 'error'))]" />
                <filter name="with_error" string="Con error" domain="[('state', '=', 'error')]" />
                <filter name="done" string="Terminados" domain="[('state', '=', 'done')]" />
                <group>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_ivess_accounting_summary_job" model="ir.actions.act_window">
        <field name="name">Cierres Mensuales en Proceso</field>
        <field name="res_model">ivess.accounting.summary.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ivess_accounting_summary_job_search" />
    </record>

    <menuitem
        id="menu_ivess_accounting_summary_job"
        name="Cierres Mensuales en Proceso"
        parent="account.account_closing_menu"
        action="action_ivess_accounting_summary_job"
        sequence="11"
    />
</odoo>
