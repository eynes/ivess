<odoo>
    <record id="view_account_journal_form_ivess_accounting_summary" model="ir.ui.view">
        <field name="name">account.journal.form.ivess.accounting.summary</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="x_is_legal_journal" />
            </xpath>
        </field>
    </record>
</odoo>
