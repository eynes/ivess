<odoo noupdate="1">
    <!-- Avanza los cierres mensuales grandes por tandas (ver
         ivess.accounting.summary.job). El asistente lo dispara al encolar un
         cierre; este horario es el respaldo si una ejecución se corta. -->
    <record id="ir_cron_summary_jobs" model="ir.cron">
        <field name="name">Cierre Mensual: procesar cierres en segundo plano</field>
        <field name="model_id" ref="model_ivess_accounting_summary_job" />
        <field name="state">code</field>
        <field name="code">model._cron_process_jobs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
    </record>
</odoo>
