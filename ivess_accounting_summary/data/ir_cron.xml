<odoo noupdate="1">
    <!-- Avanza los cierres mensuales grandes por tandas (ver
         ivess.accounting.summary.job). El asistente lo dispara al encolar un
         cierre; este horario es el respaldo si una ejecución se corta.
         Son varios crons iguales a propósito: el neteo se reparte por diario
         entre los que corran a la vez (lo limita max_cron_threads). -->
    <record id="ir_cron_summary_jobs" model="ir.cron">
        <field name="name">Cierre Mensual: procesar cierres en segundo plano</field>
        <field name="model_id" ref="model_ivess_accounting_summary_job" />
        <field name="state">code</field>
        <field name="code">model._cron_process_jobs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
    </record>

    <record id="ir_cron_summary_jobs_2" model="ir.cron">
        <field name="name">Cierre Mensual: procesar cierres en segundo plano (2)</field>
        <field name="model_id" ref="model_ivess_accounting_summary_job" />
        <field name="state">code</field>
        <field name="code">model._cron_process_jobs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
    </record>

    <record id="ir_cron_summary_jobs_3" model="ir.cron">
        <field name="name">Cierre Mensual: procesar cierres en segundo plano (3)</field>
        <field name="model_id" ref="model_ivess_accounting_summary_job" />
        <field name="state">code</field>
        <field name="code">model._cron_process_jobs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
    </record>

    <record id="ir_cron_summary_jobs_4" model="ir.cron">
        <field name="name">Cierre Mensual: procesar cierres en segundo plano (4)</field>
        <field name="model_id" ref="model_ivess_accounting_summary_job" />
        <field name="state">code</field>
        <field name="code">model._cron_process_jobs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
    </record>
</odoo>
