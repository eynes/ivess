<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Libro Diario OCA: encabezado "Diario General", columna Total, fila de
         totales, sin columna ni resumen de impuestos y socio opcional. -->
    <template
    id="report_journal_ledger_base_ivess"
    inherit_id="account_financial_report.report_journal_ledger_base"
  >
        <xpath expr="//div[hasclass('page')]/div[hasclass('row')]" position="replace">
            <div style="display: block; width: 100%; text-align: center;">
                <h4 class="mt0">DIARIO GENERAL</h4>
                <div><b t-out="o.company_id.name" /></div>
                <div>EJERCICIO: <t t-out="fiscal_year_name" /></div>
                <div>PERÍODO: <t t-out="period_text" /></div>
            </div>
        </xpath>
        <xpath
      expr="//t[@t-call='account_financial_report.report_journal_all_taxes']"
      position="replace"
    />
        <xpath
      expr="//t[@t-call='account_financial_report.report_journal_ledger_journal_taxes']"
      position="replace"
    />
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="act_as_table data_table" style="width: 100%; margin-top: 10px;">
                <div class="act_as_row lines" name="grand_total">
                    <div class="act_as_cell first_column" style="width: 74.05%;">
                        <b>TOTAL</b>
                    </div>
                    <div class="act_as_cell amount" name="debit" style="width: 8.65%;">
                        <b
              t-out="grand_total['debit']"
              t-options="{'widget': 'float', 'precision': 2}"
            />
                    </div>
                    <div class="act_as_cell amount" name="credit" style="width: 8.65%;">
                        <b
              t-out="grand_total['credit']"
              t-options="{'widget': 'float', 'precision': 2}"
            />
                    </div>
                    <div class="act_as_cell amount" name="total" style="width: 8.65%;">
                        <b
              t-out="grand_total['total']"
              t-options="{'widget': 'float', 'precision': 2}"
            />
                    </div>
                </div>
            </div>
        </xpath>
    </template>
    <template
    id="report_journal_ledger_journal_table_header_ivess"
    inherit_id="account_financial_report.report_journal_ledger_journal_table_header"
  >
        <xpath expr="//div[@name='taxes']" position="replace" />
        <xpath expr="//div[@name='partner']" position="attributes">
            <attribute name="t-if">not hide_partner</attribute>
        </xpath>
        <!-- La traducción es_AR de "Debit"/"Credit" en account_financial_report
             viene con la codificación rota ("D??bito"); se fija el texto acá. -->
        <xpath expr="//div[@name='debit']" position="replace">
            <div class="act_as_cell" name="debit" style="width: 8.65%;">Débito</div>
        </xpath>
        <xpath expr="//div[@name='credit']" position="replace">
            <div class="act_as_cell" name="credit" style="width: 8.65%;">Crédito</div>
        </xpath>
        <xpath expr="//div[@name='credit']" position="after">
            <div class="act_as_cell" name="total" style="width: 8.65%;">Total</div>
        </xpath>
    </template>
    <template
    id="report_journal_ledger_journal_first_line_ivess"
    inherit_id="account_financial_report.report_journal_ledger_journal_first_line"
  >
        <xpath expr="//div[@name='taxes']" position="replace" />
        <xpath expr="//div[@name='partner']" position="attributes">
            <attribute name="t-if">not hide_partner</attribute>
        </xpath>
        <xpath expr="//div[@name='credit']" position="after">
            <div class="act_as_cell amount" name="total">
                <b
          t-out="journal['total']"
          t-options="{'widget': 'float', 'precision': 2}"
        />
            </div>
        </xpath>
    </template>
    <template
    id="report_journal_move_line_ivess"
    inherit_id="account_financial_report.report_journal_move_line"
  >
        <xpath expr="//div[@name='taxes']" position="replace" />
        <xpath expr="//div[@name='partner']" position="attributes">
            <attribute name="t-if">not hide_partner</attribute>
        </xpath>
        <xpath expr="//div[@name='credit']" position="after">
            <div class="act_as_cell amount" name="total">
                <span
          t-out="move_line['total']"
          t-options="{'widget': 'float', 'precision': 2}"
        />
            </div>
        </xpath>
    </template>
</odoo>
