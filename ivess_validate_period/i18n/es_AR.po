#. module: ivess_validate_period
#. odoo-python
#: code:addons/ivess_validate_period/models/account_move.py:0
#, python-format
msgid ""
"Document: %s\n"
"The accounting date (%s) is earlier than the journal closing date (%s).\n"
"Autocorrecting to suggested date: %s.\n"
"\n"
"PLEASE RELOAD THE PAGE TO SEE THE UPDATED DATE, OR TRY TO VALIDATE AGAIN — THE NEW DATE WILL ALREADY BE USED."
msgstr ""
"Documento: %s\n"
"La fecha contable (%s) es anterior a la fecha de cierre del diario (%s).\n"
"Se corregirá automáticamente a la fecha sugerida: %s.\n"
"\n"
"POR FAVOR, RECARGUE LA PÁGINA PARA VER LA FECHA ACTUALIZADA, O INTENTE VALIDAR NUEVAMENTE — LA NUEVA FECHA YA ESTÁ SIENDO UTILIZADA."

#. module: ivess_validate_period
#. odoo-python
#: code:addons/ivess_validate_period/models/account_move.py:0
#, python-format
msgid ""
"Document: %s\n"
"The invoice date (%s) cannot be later than the accounting date (%s)."
msgstr ""
"Documento: %s\n"
"La fecha del comprobante (%s) no puede ser posterior a la fecha contable (%s)."

#. module: ivess_validate_period
#. odoo-python
#: code:addons/ivess_validate_period/models/account_move.py:0
#, python-format
msgid ""
"Document: %s\n"
"The journal does not have a closing date established.\n"
"Please configure it in: Accounting → Journals → Update journal periods."
msgstr ""
"Documento: %s\n"
"El diario no tiene una fecha de cierre establecida.\n"
"Por favor, configúrela en: Contabilidad → Diarios → Actualizar períodos de diarios."
