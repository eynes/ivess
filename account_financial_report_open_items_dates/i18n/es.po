#. module: account_financial_report_open_items_dates
#: model:ir.model.fields,help:account_financial_report_open_items_dates.field_open_items_report_wizard__document_date_from
#: model:ir.model.fields,help:account_financial_report_open_items_dates.field_open_items_report_wizard__document_date_to
msgid ""
"Filter open items by document date (invoice date). Only relevant for "
"invoices (e.g. vendor bills), where the document date can differ from the "
"accounting date."
msgstr ""
"Filtra las partidas abiertas por fecha de factura. Sólo es relevante para "
"facturas (por ejemplo, facturas de proveedores), donde la fecha de "
"factura puede diferir de la fecha contable."

#. module: account_financial_report_open_items_dates
#: model:ir.model.fields,field_description:account_financial_report_open_items_dates.field_open_items_report_wizard__filter_by_document_date
msgid "Filter by document date"
msgstr "Filtrar por fecha de factura"

#. module: account_financial_report_open_items_dates
#: model:ir.model.fields,help:account_financial_report_open_items_dates.field_open_items_report_wizard__filter_by_document_date
msgid ""
"If disabled, open items are filtered only by the accounting date (native "
"behavior). If enabled, open items are also filtered by their document "
"date (invoice date) using the range below."
msgstr ""
"Si está desactivado, las partidas abiertas se filtran solo por la fecha "
"contable (comportamiento nativo). Si está activado, también se filtran "
"por su fecha de factura usando el rango de abajo."
