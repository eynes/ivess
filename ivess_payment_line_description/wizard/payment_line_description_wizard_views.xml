<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payment_line_description_wizard_form" model="ir.ui.view">
        <field name="name">payment.line.description.wizard.form</field>
        <field name="model">payment.line.description.wizard</field>
        <field name="arch" type="xml">
            <form string="Editar descripción de líneas de pago">
                <field name="payment_order_id" invisible="1" />
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="payment_line_id" column_invisible="1" />
                        <field name="payment_mode_id" readonly="1" />
                        <field name="date" readonly="1" />
                        <field name="amount" readonly="1" />
                        <field name="name" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_apply"
                        string="Aplicar"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancelar"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
