<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_company_group_rule_user" model="ir.rule">
        <field
      name="name"
    >Grupo de empresas: usuarios ven solo grupos de sus empresas</field>
        <field name="model_id" ref="model_res_company_group" />
        <field name="domain_force">[('company_ids', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="res_company_group_rule_system" model="ir.rule">
        <field name="name">Grupo de empresas: administradores ven todos</field>
        <field name="model_id" ref="model_res_company_group" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
</odoo>
