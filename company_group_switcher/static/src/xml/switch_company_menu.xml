<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-inherit="web.SwitchCompanyMenu" t-inherit-mode="extension">
    <xpath expr="//button[@data-hotkey='shift+u']" position="attributes">
        <attribute name="t-att-title">currentLabel</attribute>
    </xpath>
    <xpath expr="//span[hasclass('oe_topbar_name')]" position="attributes">
        <attribute name="t-esc">currentLabel</attribute>
    </xpath>
</t>

<t t-inherit="web.SwitchCompanyMenu.Items" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_switch_company_menu_items')]" position="before">
        <div t-if="showGroups" class="o_company_group_items mb-2">
            <div class="dropdown-header text-uppercase small">Grupos</div>
            <t t-foreach="companyGroups" t-as="group" t-key="group.id">
                <span
            class="o_company_group_item dropdown-item d-flex align-items-center o-navigable"
            t-att-class="{ 'alert-secondary': companySelector.isGroupActive(group) }"
            tabindex="0"
            role="button"
            t-att-data-group-id="group.id"
            t-att-title="'Activar ' + group.name"
            t-on-click="() => companySelector.switchGroup(group)"
          >
                    <i class="fa fa-fw fa-sitemap me-2" />
                    <span class="flex-grow-1 text-truncate" t-out="group.name" />
                    <i
              t-if="companySelector.isGroupActive(group)"
              class="fa fa-check text-primary ms-2"
            />
                </span>
            </t>
            <div class="dropdown-divider" />
        </div>
    </xpath>
</t>

</templates>
