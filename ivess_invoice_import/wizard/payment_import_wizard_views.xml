<odoo>
    <record id="view_ivess_payment_import_wizard_form" model="ir.ui.view">
        <field name="name">ivess.payment.import.wizard.form</field>
        <field name="model">ivess.payment.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar cobros de clientes desde Excel">
                <field name="state" invisible="1" />

                <!-- La carga se cortó (servidor caído o reiniciado): hay que
                     volver a empezar -->
                <div
          class="alert alert-warning"
          role="alert"
          invisible="state != 'interrupted'"
        >
                    <strong>La carga se interrumpió.</strong>
                    Volvé a empezar: subí el archivo de nuevo y previsualizá. Los
                    cobros que ya se habían creado se detectan como "Ya existe" y
                    no se duplican.
                    <field name="process_error" invisible="not process_error" />
                </div>

                <!-- Paso 1: carga de archivo -->
                <group invisible="state != 'upload'">
                    <field name="filename" invisible="1" />
                    <field name="file" filename="filename" />
                </group>

                <!-- Paso 2: previsualización -->
                <group invisible="state not in ('preview', 'interrupted', 'done')" col="4">
                    <field name="total_count" />
                    <field name="ok_count" />
                    <field name="error_count" />
                    <field name="skipped_count" />
                </group>
                <button
          name="action_export_errors"
          type="object"
          string="Exportar errores (CSV)"
          invisible="state not in ('preview', 'done') or error_count == 0"
        />
                <field
          name="result_line_ids"
          invisible="state not in ('preview', 'interrupted', 'done')"
        >
                    <list
            decoration-danger="has_error and resultado != 'ok'"
            decoration-success="resultado == 'ok'"
            decoration-muted="resultado == 'skipped'"
          >
                        <field name="comprobante_display" />
                        <field name="partner_id" />
                        <field name="cliente_codigo" optional="show" />
                        <field name="journal_id" optional="show" />
                        <field name="fecha" />
                        <field name="importe_total" sum="Total" />
                        <field
              name="estado_proyectado"
              invisible="resultado != 'pending'"
            />
                        <field
              name="resultado"
              invisible="resultado == 'pending'"
              decoration-success="resultado == 'ok'"
              decoration-danger="resultado == 'error'"
            />
                        <field name="detail_count" />
                        <field name="has_error" invisible="1" />
                        <field name="error_message" optional="show" />
                        <field
              name="warning_message"
              optional="show"
              decoration-warning="warning_message"
            />
                        <field name="odoo_payment_order_id" optional="show" />
                    </list>
                    <form string="Cobro">
                        <group col="4">
                            <field name="comprobante_display" />
                            <field name="partner_id" />
                            <field name="cliente_codigo" />
                            <field name="journal_id" />
                            <field name="fecha" />
                            <field name="importe_total" />
                            <field name="estado_proyectado" />
                            <field name="odoo_payment_order_id" />
                        </group>
                        <field name="error_message" invisible="not has_error" />
                        <field
              name="warning_message"
              invisible="not warning_message"
              decoration-warning="warning_message"
            />
                        <field name="detail_line_ids">
                            <list editable="bottom" create="0" delete="0">
                                <field name="candidate_invoice_ids" column_invisible="1" />
                                <field name="tipo_compr_asoc" readonly="1" />
                                <field readonly="1" name="letra_asoc" />
                                <field readonly="1" name="pto_venta_asoc" />
                                <field readonly="1" name="numero_compr_asoc" />
                                <field name="invoice_id" readonly="not candidate_invoice_ids" options="{'no_create': True, 'no_open': True}" />
                                <field readonly="1" name="importe" />
                                <field readonly="1" name="payment_mode_id" optional="show" />
                                <field readonly="1" name="medio_pago" optional="show" />
                                <field readonly="1" name="caja" optional="show" />
                                <field readonly="1" name="moneda" optional="hide" />
                                <field readonly="1" name="tipo_cambio" optional="hide" />
                                <field readonly="1" name="cod_bco" optional="hide" />
                                <field readonly="1" name="sucursal_bco" optional="hide" />
                                <field readonly="1" name="nro_cheque" optional="show" />
                                <field readonly="1" name="check_type" optional="show" />
                                <field readonly="1" name="check_format" optional="show" />
                                <field readonly="1" name="bank_id" optional="show" />
                                <field readonly="1" name="reception_date" optional="hide" />
                                <field readonly="1" name="issue_date" optional="hide" />
                                <field readonly="1" name="payment_date" optional="show" />
                                <field readonly="1" name="has_error" invisible="1" />
                                <field
                  readonly="1"
                  name="error_message"
                  decoration-danger="has_error"
                />
                            </list>
                        </field>
                        <field name="retention_line_ids" invisible="not retention_line_ids">
                            <list>
                                <field name="codigo" />
                                <field name="tax_id" />
                                <field name="importe" />
                                <field name="has_error" invisible="1" />
                                <field
                  name="error_message"
                  decoration-danger="has_error"
                />
                            </list>
                        </field>
                    </form>
                </field>

                <footer>
                    <button
            name="action_preview"
            type="object"
            string="Previsualizar"
            class="btn-primary"
            invisible="state != 'upload'"
          />
                    <button
            name="action_confirm"
            type="object"
            string="Confirmar importación"
            class="btn-primary"
            invisible="state != 'preview'"
            confirm="Se van a crear los cobros sin errores (los anulados en origen no se importan). ¿Confirmar?"
          />
                    <button
            name="action_back_to_upload"
            type="object"
            string="Volver"
            invisible="state != 'preview'"
          />
                    <button
            name="action_back_to_upload"
            type="object"
            string="Volver a empezar"
            class="btn-primary"
            invisible="state != 'interrupted'"
          />
                    <button string="Cerrar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Vista liviana mientras se procesa: sin la lista de recibos, para poder
         recargarla cada pocos segundos. -->
    <record id="view_ivess_payment_import_wizard_progress" model="ir.ui.view">
        <field name="name">ivess.payment.import.wizard.progress</field>
        <field name="model">ivess.payment.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importando cobros...">
                <field name="state" invisible="1" />
                <field name="progress_total" invisible="1" />
                <field name="is_stalled" invisible="1" />
                <div class="text-center py-4">
                    <h3>Importando cobros…</h3>
                    <p class="text-muted">
                        Podés cerrar esta ventana: la importación sigue en segundo plano.
                    </p>
                    <field
            name="progress_done"
            widget="ivess_import_progressbar"
            options="{'max_value': 'progress_total'}"
          />
                </div>
                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ivess_payment_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar cobros de clientes (Excel)</field>
        <field name="res_model">ivess.payment.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
    id="menu_ivess_payment_import"
    name="Importar cobros de clientes (Excel)"
    parent="account.menu_finance_receivables"
    action="action_ivess_payment_import_wizard"
    sequence="121"
  />
</odoo>
