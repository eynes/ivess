<odoo noupdate="1">
    <!-- Procesa las importaciones de cobros confirmadas. No corre por
         calendario: lo dispara el botón "Confirmar importación"
         (ir.cron._trigger), el intervalo es solo el mínimo de Odoo. -->
    <record id="ir_cron_payment_import" model="ir.cron">
        <field name="name">Importación de cobros: procesar confirmadas</field>
        <field name="model_id" ref="model_ivess_payment_import_wizard" />
        <field name="state">code</field>
        <field name="code">model._cron_process_pending()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>
</odoo>
