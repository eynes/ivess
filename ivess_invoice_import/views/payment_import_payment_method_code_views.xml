<odoo>
    <record id="view_ivess_payment_import_payment_method_code_list" model="ir.ui.view">
        <field name="name">ivess.payment.import.payment.method.code.list</field>
        <field name="model">ivess.payment.import.payment.method.code</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="medio_pago" />
                <field name="caja" />
                <field name="cod_bco" />
                <field name="sucursal_bco" />
                <field name="journal_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record
    id="action_ivess_payment_import_payment_method_code"
    model="ir.actions.act_window"
  >
        <field name="name">Medios de pago (importación de cobros)</field>
        <field name="res_model">ivess.payment.import.payment.method.code</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Mapeá cada combinación de "medio de pago" + "caja" (o + "cod
                bco" / "sucursal del bco" para medios bancarios) del Excel
                de importación de cobros con el diario de caja/banco de Odoo
                correspondiente.
            </p>
        </field>
    </record>

    <menuitem
    id="menu_ivess_payment_import_payment_method_code"
    name="Medios de pago (importación de cobros)"
    parent="account.menu_finance_configuration"
    action="action_ivess_payment_import_payment_method_code"
    sequence="201"
  />
</odoo>
