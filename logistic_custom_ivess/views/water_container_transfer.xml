<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_water_container_transfer_list" model="ir.ui.view">
        <field name="name">water.container.transfer.list</field>
        <field name="model">water.container.transfer</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="origin_partner_id"/>
                <field name="dest_partner_id"/>
                <field name="product_id"/>
                <field name="quantity" invisible="is_frio_calor"/>
                <field name="lot_ids" widget="many2many_tags" optional="show"/>
                <field name="is_frio_calor" column_invisible="1"/>
                <field name="create_uid" string="Registrado por" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_water_container_transfer_form" model="ir.ui.view">
        <field name="name">water.container.transfer.form</field>
        <field name="model">water.container.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirmar traslado"
                            class="btn-primary" invisible="state != 'draft'"
                            confirm="Se genera y valida la devolución de la cuenta origen y la entrega a la cuenta destino. ¿Continuar?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="origin_partner_id" readonly="state == 'done'"/>
                            <field name="dest_partner_id" readonly="state == 'done'"/>
                            <field name="date" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="product_id" readonly="state == 'done'" options="{'no_create': True}"/>
                            <field name="is_frio_calor" invisible="1"/>
                            <field name="quantity" invisible="is_frio_calor" readonly="state == 'done'"/>
                            <field name="container_state" invisible="is_frio_calor" readonly="state == 'done'"/>
                            <field name="lot_ids" widget="many2many_tags" invisible="not is_frio_calor"
                                   readonly="state == 'done'" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Movimientos de stock">
                            <field name="return_picking_type_id" readonly="state == 'done'" options="{'no_create': True}"/>
                            <field name="delivery_picking_type_id" readonly="state == 'done'" options="{'no_create': True}"/>
                            <field name="return_picking_id" invisible="not return_picking_id"/>
                            <field name="delivery_picking_id" invisible="not delivery_picking_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Por qué se trasladan los envases..." readonly="state == 'done'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_water_container_transfer" model="ir.actions.act_window">
        <field name="name">Traslados de Envases</field>
        <field name="res_model">water.container.transfer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_water_container_transfer"
              name="Traslados de Envases"
              parent="crm.crm_menu_config"
              sequence="21"
              action="action_water_container_transfer"/>
</odoo>
