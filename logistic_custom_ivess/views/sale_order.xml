<odoo>

    <record id="logistic_custom_ivess_view_order_tree" model="ir.ui.view">
        <field name="name">logistic.custom.ivess.view.order.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="amount_total" position="after">
                <field name="delivery_route_id"/>
            </field>
        </field>
    </record>

    <record id="quotation_logistic_custom_ivess_view_order_tree" model="ir.ui.view">
        <field name="name">quotation.logistic.custom.ivess.view.order.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <field name="amount_total" position="after">
                <field name="delivery_route_id"/>
            </field>
        </field>
    </record>

    <record id="view_sale_order_form_inherit_delivery_route" model="ir.ui.view">
        <field name="name">view.sale.order.form.inherit.delivery.route</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not cargado_fuera_de_hora or state not in ('draft', 'sent')">
                    Pedido cargado después de la hora límite de pedidos: normalmente se agenda para el día siguiente.
                </div>
            </xpath>
            <xpath expr="//field[@name='source_id']" position="after">
                <field name="delivery_route_id"/>
                <field name="cargado_fuera_de_hora" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="free_of_charge" optional="show"/>
                <field name="fecha_programada" optional="show" invisible="product_type != 'service'"/>
                <field name="turno" optional="show" invisible="product_type != 'service'"/>
            </xpath>
        </field>
    </record>
</odoo>
