<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_partner_view_form_inherit_padron_error" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.padron.error</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="after">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not padron_update_error"
                >
                    <strong>Error al actualizar el Padrón de Perc/Ret:</strong>
                    <field name="padron_update_error" nolabel="1" readonly="1" />
                </div>
            </xpath>

        </field>
    </record>

</odoo>
